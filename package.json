{
  "name": "stellata",
  "version": "2.14.3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Alex Marshall",
  "scripts": {
    "build:catalog": "tsx scripts/catalog/build-catalog.ts",
    "build:lut": "tsx scripts/colour/blackbody-lut.ts",
    "build:binaries": "python3 scripts/binaries/build-binaries.py",
    "build:binaries-runtime": "python3 scripts/binaries/build-runtime-binaries.py",
    "build:clouds": "python3 scripts/clouds/build-clouds.py",
    "refresh:gaia-hip": "python3 scripts/refresh/refresh-gaia-hip-xmatch.py",
    "refresh:gaia-tyc": "python3 scripts/refresh/refresh-gaia-tyc-xmatch.py",
    "refresh:gaia-nss": "python3 scripts/refresh/refresh-gaia-nss.py",
    "refresh:bailer-jones": "python3 scripts/refresh/refresh-bailer-jones.py",
    "refresh:gaia-apsis": "python3 scripts/refresh/refresh-gaia-apsis.py",
    "refresh:gaia-astrometry": "python3 scripts/refresh/refresh-gaia-astrometry.py",
    "refresh:gaia-astrometry-catalog": "python3 scripts/refresh/refresh-gaia-astrometry-catalog.py",
    "build:astrometry-request": "tsx scripts/catalog/export-astrometry-request.ts",
    "refresh:hip2": "python3 scripts/refresh/refresh-hipparcos2.py",
    "refresh:simbad": "python3 scripts/refresh/refresh-simbad-sample.py",
    "validate:simbad": "tsx scripts/catalog/validate-simbad-sample.ts",
    "build:local-group": "tsx scripts/local-group/build-local-group.ts",
    "build:dust-sync": "tsx scripts/dust/sync-dust.ts",
    "build:client": "vite build",
    "build": "npm run build:binaries && npm run build:catalog && npm run build:binaries-runtime && npm run build:clouds && npm run build:local-group && npm run build:dust-sync && npm run build:client",
    "dev": "npm run build:binaries && npm run build:catalog && npm run build:binaries-runtime && npm run build:clouds && npm run build:local-group && npm run build:dust-sync && vite",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^20.10.0",
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^4.1.5",
    "csv-parse": "^5.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260701.1": true,
    "fsevents@2.3.3": true
  }
}
