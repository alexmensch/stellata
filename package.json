{
  "name": "stellata",
  "version": "2.37.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "license": "AGPL-3.0-only",
  "author": "Alex Marshall",
  "scripts": {
    "build:catalog": "tsx scripts/catalog/build-catalog.ts",
    "build:lut": "tsx scripts/colour/blackbody-lut.ts",
    "build:binaries": "python3 scripts/binaries/build-binaries.py",
    "build:binaries-runtime": "python3 scripts/binaries/build-runtime-binaries.py",
    "build:clouds": "python3 scripts/clouds/build-clouds.py && tsx scripts/sid/stamp-sibling-sids.ts clouds",
    "refresh:gaia-hip": "python3 scripts/refresh/refresh-gaia-hip-xmatch.py",
    "refresh:gaia-tyc": "python3 scripts/refresh/refresh-gaia-tyc-xmatch.py",
    "refresh:gaia-nss": "python3 scripts/refresh/refresh-gaia-nss.py",
    "refresh:bailer-jones": "python3 scripts/refresh/refresh-bailer-jones.py",
    "refresh:gaia-apsis": "python3 scripts/refresh/refresh-gaia-apsis.py",
    "refresh:gaia-astrometry": "python3 scripts/refresh/refresh-gaia-astrometry.py",
    "refresh:gaia-astrometry-catalog": "python3 scripts/refresh/refresh-gaia-astrometry-catalog.py",
    "refresh:gaia-dr2-neighbourhood": "python3 scripts/refresh/refresh-gaia-dr2-neighbourhood.py",
    "build:astrometry-request": "tsx scripts/catalog/export-astrometry-request.ts",
    "sid:allocate": "tsx scripts/sid/allocate.ts",
    "sid:check": "tsx scripts/sid/allocate.ts --check",
    "sid:stamp": "tsx scripts/sid/stamp-sibling-sids.ts all",
    "sid:risk-set": "tsx scripts/sid/export-dr-risk-set.ts",
    "sid:dr-reconcile": "tsx scripts/sid/dr-reconcile.ts",
    "refresh:hip2": "python3 scripts/refresh/refresh-hipparcos2.py",
    "refresh:simbad": "python3 scripts/refresh/refresh-simbad-sample.py",
    "validate:simbad": "tsx scripts/catalog/validate-simbad-sample.ts",
    "build:local-group": "tsx scripts/local-group/build-local-group.ts && tsx scripts/sid/stamp-sibling-sids.ts local-group",
    "build:dust-sync": "tsx scripts/dust/sync-dust.ts",
    "build:textures": "python3 scripts/textures/build-textures.py",
    "build:textures-sync": "tsx scripts/textures/sync-textures.ts",
    "build:client": "vite build",
    "build": "pnpm run build:binaries && pnpm run build:catalog && pnpm run build:binaries-runtime && pnpm run build:clouds && pnpm run build:local-group && pnpm run build:dust-sync && pnpm run build:textures-sync && pnpm run build:client",
    "dev": "pnpm run build:binaries && pnpm run build:catalog && pnpm run build:binaries-runtime && pnpm run build:clouds && pnpm run build:local-group && pnpm run build:dust-sync && pnpm run build:textures-sync && vite",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:spotcheck": "python3 scripts/binaries/build-binaries-spotcheck.py",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^20.10.0",
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^4.1.5",
    "csv-parse": "^5.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  }
}
