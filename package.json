{
  "name": "stellata",
  "version": "7.1.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "license": "AGPL-3.0-only",
  "author": "Alex Marshall",
  "scripts": {
    "build:catalog": "tsx scripts/pipeline/run.ts build:catalog",
    "build:lut": "tsx scripts/colour/blackbody-lut.ts",
    "build:icons": "python3 scripts/icons/build-icons.py",
    "build:og": "python3 scripts/og/build-og.py",
    "build:binaries": "tsx scripts/pipeline/run.ts build:binaries",
    "build:binaries-runtime": "tsx scripts/pipeline/run.ts build:binaries-runtime",
    "build:clouds": "python3 scripts/clouds/build-clouds.py && tsx scripts/sid/stamp-sibling-sids.ts",
    "build:local-bubble": "python3 scripts/local-bubble/build-local-bubble.py",
    "build:local-bubble-sync": "tsx scripts/local-bubble/sync-local-bubble.ts",
    "build:cloud-surfaces": "python3 scripts/cloud-surfaces/build-cloud-surfaces.py",
    "build:cloud-surfaces-sync": "tsx scripts/cloud-surfaces/sync-cloud-surfaces.ts",
    "refresh:gaia-hip": "python3 scripts/refresh/refresh-gaia-hip-xmatch.py",
    "refresh:gaia-tyc": "python3 scripts/refresh/refresh-gaia-tyc-xmatch.py",
    "refresh:gaia-nss": "python3 scripts/refresh/refresh-gaia-nss.py",
    "refresh:bailer-jones": "python3 scripts/refresh/refresh-bailer-jones.py",
    "refresh:gaia-apsis": "python3 scripts/refresh/refresh-gaia-apsis.py",
    "refresh:gaia-astrometry": "python3 scripts/refresh/refresh-gaia-astrometry.py",
    "refresh:gaia-astrometry-catalog": "python3 scripts/refresh/refresh-gaia-astrometry-catalog.py",
    "refresh:gaia-dr2-neighbourhood": "python3 scripts/refresh/refresh-gaia-dr2-neighbourhood.py",
    "refresh:gaia-gspc": "python3 scripts/refresh/refresh-gaia-gspc.py",
    "refresh:gaia-magnitude": "python3 scripts/refresh/refresh-gaia-magnitude.py",
    "build:astrometry-request": "tsx scripts/pipeline/run.ts build:astrometry-request",
    "build:classic-ids": "tsx scripts/pipeline/run.ts build:classic-ids",
    "build:wgsn": "tsx scripts/pipeline/run.ts build:wgsn",
    "build:naming-parity": "tsx scripts/catalog/naming/build-naming-parity.ts",
    "audit:spine-primaries": "tsx scripts/catalog/spine/primaries-audit.ts",
    "audit:spine-associations": "tsx scripts/catalog/spine/association-audit.ts",
    "build:membership": "tsx scripts/pipeline/run.ts build:membership",
    "lineage:codes": "tsx scripts/pipeline/run.ts lineage:codes",
    "trace": "tsx scripts/catalog/lineage/trace.ts",
    "refresh:iau-wgsn": "python3 scripts/refresh/refresh-iau-wgsn.py",
    "sid:stamp": "tsx scripts/sid/stamp-sibling-sids.ts",
    "sid:risk-set": "tsx scripts/sid/export-dr-risk-set.ts",
    "sid:dr-reconcile": "tsx scripts/sid/dr-reconcile.ts",
    "refresh:hip2": "python3 scripts/refresh/refresh-hipparcos2.py",
    "refresh:hip-vmag": "python3 scripts/refresh/refresh-hipparcos-vmag.py",
    "refresh:classic-ids": "python3 scripts/refresh/refresh-classic-ids.py",
    "refresh:tycho2": "python3 scripts/refresh/refresh-tycho2.py",
    "refresh:gliese": "python3 scripts/refresh/refresh-gliese.py",
    "refresh:simbad": "python3 scripts/refresh/refresh-simbad-sample.py",
    "refresh:simbad-values": "python3 scripts/refresh/refresh-simbad-values.py",
    "refresh:simbad-tyc-hd": "python3 scripts/refresh/refresh-simbad-tyc-hd.py",
    "fetch:probes": "tsx scripts/probes/fetch-probe-trajectories.ts",
    "fetch:ephemerides": "tsx scripts/ephemerides/fetch-planet-elements.ts",
    "validate:simbad": "tsx scripts/catalog/validate/validate-simbad-sample.ts",
    "validate:record-parity": "tsx scripts/catalog/validate/record-parity.ts",
    "identity:snapshot": "tsx scripts/util/output-identity.ts snapshot",
    "identity:diff": "tsx scripts/util/output-identity.ts diff",
    "analyse:prefilter": "tsx scripts/dust/prefilter/measure.ts",
    "analyse:prefilter-cost": "tsx scripts/dust/prefilter/cost.ts",
    "analyse:march-taps": "tsx scripts/dust/march-taps/measure.ts",
    "measure:band-resolved": "tsx scripts/milkyway-calibration/measure-resolved-light.ts",
    "build:local-group": "tsx scripts/local-group/build-local-group.ts",
    "build:dust-sync": "tsx scripts/dust/sync-dust.ts",
    "build:probes-sync": "tsx scripts/probes/sync-probes.ts",
    "build:ephemerides-sync": "tsx scripts/ephemerides/sync-ephemerides.ts",
    "build:textures": "python3 scripts/textures/build-textures.py",
    "build:textures-sync": "tsx scripts/textures/sync-textures.ts",
    "build:client": "vite build",
    "build:stamped": "tsx scripts/pipeline/run.ts build:binaries-runtime build:astrometry-request",
    "build:mtime-gated": "pnpm run build:clouds && pnpm run build:local-group && pnpm run build:dust-sync && pnpm run build:probes-sync && pnpm run build:ephemerides-sync && pnpm run build:local-bubble-sync && pnpm run build:cloud-surfaces-sync && pnpm run build:textures-sync",
    "build:site": "vite build --config vite.site.config.ts",
    "build:layers": "tsx scripts/pipeline/run.ts build:binaries-runtime && pnpm run build:mtime-gated",
    "build:data": "pnpm run build:stamped && pnpm run build:mtime-gated",
    "build": "pnpm run build:data && pnpm run build:client && pnpm run build:site",
    "build:seed": "bash scripts/build-seed.sh",
    "build:seed-steps": "tsx scripts/pipeline/run.ts build:binaries-runtime",
    "dev": "pnpm run build:data && vite",
    "dev:site": "vite --config vite.site.config.ts",
    "check:asset-sizes": "tsx scripts/release/check-asset-sizes.ts",
    "docs:figures": "tsx scripts/doc-figures/rewrite-doc-figures.ts",
    "deploy": "pnpm run build && pnpm run check:asset-sizes && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "perf": "tsx scripts/perf/run.ts",
    "survivors": "tsx scripts/perf/survivors.ts",
    "perf:pin": "tsx scripts/perf/pin.ts",
    "perf:synthetic": "tsx scripts/perf/synthetic-catalog/build-synthetic-catalog.ts",
    "test": "vitest run",
    "test:py": "python3 scripts/ci/python_tests.py",
    "test:no-skip": "tsx scripts/ci/vitest-no-skip.ts",
    "test:spotcheck": "python3 scripts/binaries/build-binaries-spotcheck.py",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^20.10.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.5",
    "csv-parse": "^7.0.2",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "happy-dom": "^21.0.4",
    "hast-util-select": "^6.0.4",
    "marked": "^18.0.14",
    "playwright": "1.62.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  }
}
