node_modules
dist/
.wrangler/
.vite/
.claude/*
!.claude/settings.json
.DS_Store
*.log
# Root-anchored: vitest writes ./coverage, and an unanchored rule silently
# swallows any source folder that earns the name.
/coverage/

# Generated catalog artifacts (regenerated from source CSV). catalog.bin
# ships as transport chunks (catalog.bin.<i>) + catalog-manifest.json.
public/catalog.bin.*
public/catalog-manifest.json
public/catalog-row-index-map.json
public/constellations.json
public/constellation-boundaries.json
public/search-index.json
public/clouds.json
public/local-group.json
public/binaries.bin
public/local-bubble.bin
public/cloud-surfaces.bin
public/binding-integrity-verdicts.tsv

# Mirror of data/dust/ — the canonical LFS-tracked copy lives in data/dust/;
# scripts/dust/build-dust.py copies chunks here so Vite's publicDir serves them.
public/dust/

# Mirror of data/textures/ artifacts — scripts/textures/sync-textures.ts
# copies the built per-body maps here so Vite's publicDir serves them.
public/textures/

# Mirror of data/probes/ — scripts/probes/sync-probes.ts copies the
# committed trajectory JSONs here so Vite's publicDir serves them.
public/probes/

# Mirror of data/ephemerides/ — scripts/ephemerides/sync-ephemerides.ts copies
# the committed planet element tables here so Vite's publicDir serves them.
public/ephemerides/

# Manual-run validation report emitted by `pnpm run validate:simbad`.
# Local-only — re-run when investigating drift.
docs/validation-residuals.md

# Raw-resample cache for build-dust.py. ~512 MiB float32 grid; lets us
# re-encode without re-running the 10-minute query phase. Local-only.
data/dust/.voxels.npy

# Per-batch resume cache written by refresh_lib.BatchCheckpoint. Survives a
# failed run on purpose so a re-run resumes; deleted once the pull completes.
data/**/*.tsv.ckpt/

# Python venv for scripts/dust/build-dust.py and refresh scripts
.venv/

# Python bytecode cache (refresh_lib gets imported by sibling test +
# refresh scripts; build-binaries.test.py imports build-binaries via
# spec_from_file_location, also populating __pycache__).
scripts/**/__pycache__/


# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
